# Runtime credentials: upload completed file as Jenkins Secret file crossbound-prod-env.
# Literal KEY=value, no quotes, no export, no inline comments. Never commit real values.
CROSSBOUND_PUBLIC_ORIGIN=https://game.example.com
# Company RDS internal endpoint supplied by the deployment team. Verify VPC connectivity.
CROSSBOUND_MYSQL_HOST=rm-wz95q3ykydacm3q5b.mysql.rds.aliyuncs.com
CROSSBOUND_MYSQL_PORT=3306
CROSSBOUND_MYSQL_DATABASE=au-crossbound
CROSSBOUND_MYSQL_USER=replace-with-runtime-db-user
CROSSBOUND_MYSQL_PASSWORD=replace-with-secret
CROSSBOUND_ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
# Generate using the command in README. Existing encrypted data requires its original key.
CROSSBOUND_CONTACT_KEY=replace-with-fernet-key
# Optional RDS TLS. Certificate paths are inside the container's mounted private directory.
CROSSBOUND_MYSQL_SSL_CA=
CROSSBOUND_MYSQL_SSL_CERT=
CROSSBOUND_MYSQL_SSL_KEY=
# Optional SMTP. Leave host empty to retain local report previews, without sending email.
CROSSBOUND_SMTP_HOST=
CROSSBOUND_SMTP_PORT=587
CROSSBOUND_SMTP_FROM=
CROSSBOUND_SMTP_USER=
CROSSBOUND_SMTP_PASSWORD=
